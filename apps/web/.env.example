VITE_API_BASE=http://127.0.0.1:8787
# mock or live. The detected backend must match before writes are enabled.
VITE_DATA_MODE=mock
# First live connectivity run: LIMIT=2 and CONCURRENCY=2.
# Demo run: LIMIT=4 and CONCURRENCY=4. Restart Vite after changing env.
VITE_RESEARCH_TOP_K=5
VITE_RESEARCH_LIMIT=4
VITE_RESEARCH_CONCURRENCY=4
