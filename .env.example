# Gemini API
# Do not commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash

# Provider aliases used by the app configuration.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
SEARCH_PROVIDER=gemini-google-search

# B API / local persistence
PORT=8787
CORS_ORIGIN=http://localhost:5173
SQLITE_PATH=trading-radar.sqlite

# Optional proactive delivery.
# TAIWAN_DATA_DB is the Data Layer SQLite snapshot, not the B metadata DB.
# Install the CLI first:
#   python -m pip install -e "packages/taiwan_data"
TAIWAN_DATA_DB=
TAIWAN_DATA_CLI=taiwan-data
TAIWAN_DATA_SCREEN_TIMEOUT_MS=120000

# Scheduler is disabled by default.
# When enabled, registered users are checked hourly; after 17:00 Asia/Taipei
# on workdays, a missed daily run is automatically caught up.
ENABLE_DAILY_SCHEDULER=false
DAILY_RESEARCH_AFTER_HOUR=17
DAILY_SCHEDULER_INTERVAL_MS=3600000
